# ==========================================
# "Meri Dukan" / Anshika Enterprises — Environment Configuration
# NEVER commit production secret values to version control.
# ==========================================

# PostgreSQL Connection String (e.g. Neon, Supabase, local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/meridukan?schema=public"

# JSON Web Token Secret (generate with: openssl rand -base64 48)
JWT_SECRET="replace-with-a-cryptographically-secure-random-string"

# Express Port (Default: 5000)
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV="development"

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5000"

# Redis URL for BullMQ and multi-tenant cacheService (e.g. redis://127.0.0.1:6379)
REDIS_URL="redis://localhost:6379"

# AES-256-GCM Encryption Key (Must be 32 bytes or 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-32-byte-hex-encryption-key-for-bank-accounts"

# SMTP Email Configuration (for invoices, quotations, low stock alerts)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-app-password"
