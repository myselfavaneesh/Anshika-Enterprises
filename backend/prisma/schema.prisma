// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        String   @default("staff") // "admin" | "manager" | "staff"
  permissions Json     @default("[]")    // Array of permission strings e.g. ["sales:view","sales:create"]
  isActive    Boolean  @default(true)    // Soft disable staff — inactive users can't login
  phone       String?
  createdBy   String?                    // UUID of admin who created this staff
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions      Session[]
  loginHistory  LoginHistory[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id                String   @id @default(uuid())
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  name              String
  sku               String   @unique
  hsnCode           String?
  unit              String   @default("PC") // PC, NOS, SET, KG, MTR, LTR, W
  gstRate           Decimal  @default(0) @db.Decimal(5, 2)
  trackSerials      Boolean  @default(true) // true=serial tracked, false=quantity only
  lowStockThreshold Int      @default(5)
  purchasePrice     Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice      Decimal  @default(0) @db.Decimal(12, 2)
  isGstInclusive    Boolean  @default(true)
  wattage           Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inventories           Inventory?
  inventoryTransactions InventoryTransaction[]
  productUnits          ProductUnit[]
  purchaseItems         PurchaseItem[]
  quotationItems        QuotationItem[]
  saleItems             SaleItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  inventoryAuditItems   InventoryAuditItem[]

  @@index([categoryId])
  @@index([hsnCode])
  @@index([sku])
  @@index([name])
}

model Inventory {
  id        String   @id @default(uuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryTransaction {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  transactionType String   // 'IN' | 'OUT' | 'ADJUSTMENT'
  quantity        Int
  referenceType   String?
  referenceId     String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([createdAt])
}

model Customer {
  id                 String   @id @default(uuid())
  name               String
  phone              String?
  email              String?
  address            String?
  gstNumber          String?
  state              String?
  stateCode          String?
  group              String?
  creditLimit        Decimal? @db.Decimal(12, 2)
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  quotations    Quotation[]
  sales         Sale[]
  saleReturns   SaleReturn[]
  subscriptions Subscription[]

  @@index([phone])
  @@index([name])
  @@index([gstNumber])
  @@index([deletedAt])
}

model Supplier {
  id                 String   @id @default(uuid())
  name               String
  phone              String?
  email              String?
  address            String?
  gstNumber          String?
  state              String?
  stateCode          String?
  group              String?
  creditLimit        Decimal? @db.Decimal(12, 2)
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  purchases     Purchase[]
  productUnits  ProductUnit[]
  purchaseOrders PurchaseOrder[]

  @@index([phone])
  @@index([name])
  @@index([deletedAt])
}

model Payment {
  id          String   @id @default(uuid())
  entityType  String   // 'CUSTOMER' | 'SUPPLIER'
  entityId    String
  type        String   // 'MONEY_IN' | 'MONEY_OUT'
  amount      Decimal  @db.Decimal(12, 2)
  paymentMode String?  // 'CASH' | 'UPI' | 'BANK' | 'CHEQUE' | 'OTHER'
  referenceId String?  @unique
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([entityId, entityType])
  @@index([deletedAt])
}

model ProductUnit {
  id                    String   @id @default(uuid())
  productId             String
  product               Product  @relation(fields: [productId], references: [id])
  serialNumber          String   @unique
  status                String   @default("IN_STOCK") // 'IN_STOCK' | 'SOLD' | 'DEFECTIVE'
  purchaseInvoiceNumber String?
  supplierName          String?
  purchaseId            String?
  purchase              Purchase? @relation(fields: [purchaseId], references: [id])
  purchaseItemId        String?
  purchaseItem          PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  supplierId            String?
  supplier              Supplier? @relation(fields: [supplierId], references: [id])
  saleId                String?
  sale                  Sale? @relation(fields: [saleId], references: [id])
  saleItemId            String?
  saleItem              SaleItem? @relation(fields: [saleItemId], references: [id])
  purchasePrice         Decimal?  @db.Decimal(12, 2)
  
  // Advanced Inventory
  warehouseId           String?
  warehouse             Warehouse? @relation(fields: [warehouseId], references: [id])
  batchNumber           String?
  manufactureDate       DateTime?
  expiryDate            DateTime?
  stockTransferItems    StockTransferItem[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([productId, status])
  @@index([saleId])
  @@index([purchaseId])
  @@index([warehouseId])
}

model Purchase {
  id                    String   @id @default(uuid())
  purchaseInvoiceNumber String
  supplierId            String
  supplier              Supplier @relation(fields: [supplierId], references: [id])
  invoiceType           String   @default("GST") // 'GST' | 'NON_GST'
  subtotal              Decimal  @db.Decimal(12, 2)
  discount              Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount         Decimal  @db.Decimal(12, 2)
  taxRate               Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount             Decimal  @default(0) @db.Decimal(12, 2)
  cgstAmount            Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount            Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal            Decimal  @db.Decimal(12, 2)
  status                String   @default("PAID") // 'PAID' | 'PENDING' | 'CANCELLED'
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  purchaseItems         PurchaseItem[]
  productUnits          ProductUnit[]

  @@unique([purchaseInvoiceNumber, supplierId])
  @@index([supplierId])
  @@index([createdAt])
  @@index([deletedAt])
}

model PurchaseItem {
  id                String   @id @default(uuid())
  purchaseId        String
  purchase          Purchase @relation(fields: [purchaseId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Decimal  @db.Decimal(12, 2)
  taxableUnitPrice  Decimal  @db.Decimal(12, 2)
  taxableTotalPrice Decimal  @db.Decimal(12, 2)
  totalPrice        Decimal  @db.Decimal(12, 2)
  gstRate           Decimal  @default(0) @db.Decimal(5, 2)
  cgstAmount        Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount        Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productUnits      ProductUnit[]

  @@index([purchaseId])
  @@index([productId])
}

model Quotation {
  id              String   @id @default(uuid())
  quotationNumber String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  invoiceType     String   @default("GST") // 'GST' | 'NON_GST'
  subtotal        Decimal  @db.Decimal(12, 2)
  discount        Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount   Decimal  @db.Decimal(12, 2)
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(12, 2)
  cgstAmount      Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount      Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal  @db.Decimal(12, 2)
  status          String   @default("DRAFT") // 'DRAFT' | 'SENT' | 'ACCEPTED' | 'REJECTED'
  validUntil      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  quotationItems    QuotationItem[]
  quotationServices QuotationService[]
  comboGroups       QuotationComboGroup[]

  @@index([customerId])
  @@index([deletedAt])
}

model QuotationItem {
  id                String   @id @default(uuid())
  quotationId       String
  quotation         Quotation @relation(fields: [quotationId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Decimal  @db.Decimal(12, 2)
  totalPrice        Decimal  @db.Decimal(12, 2)
  taxableUnitPrice  Decimal  @db.Decimal(12, 2)
  taxableTotalPrice Decimal  @db.Decimal(12, 2)
  gstRate           Decimal  @default(0) @db.Decimal(5, 2)
  cgstAmount        Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount        Decimal  @default(0) @db.Decimal(12, 2)
  wattage           Float    @default(0)
  comboGroupId      String?
  comboGroup        QuotationComboGroup? @relation(fields: [comboGroupId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([quotationId])
  @@index([productId])
}

model Sale {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  invoiceType   String   @default("GST") // 'GST' | 'NON_GST'
  subtotal      Decimal  @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal  @db.Decimal(12, 2)
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(12, 2)
  cgstAmount    Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount    Decimal  @default(0) @db.Decimal(12, 2)
  igstAmount    Decimal  @default(0) @db.Decimal(12, 2)
  roundOff      Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal  @db.Decimal(12, 2)
  status        String   @default("PAID") // 'PAID' | 'PENDING' | 'CANCELLED'
  documentType  String   @default("TAX_INVOICE") // 'TAX_INVOICE' | 'PROFORMA' | 'CHALLAN'
  placeOfSupply     String?  // State name for Place of Supply
  placeOfSupplyCode String?  // State code e.g. '09'
  
  // Compliance & Signatures
  eInvoiceAckNo         String?
  eWayBillNo            String?
  customerSignatureUrl  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  saleItems     SaleItem[]
  saleServices  SaleService[]
  saleReturns   SaleReturn[]
  productUnits  ProductUnit[]
  salePayments  SalePayment[]
  comboGroups   SaleComboGroup[]

  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@index([deletedAt])
  @@index([invoiceNumber])
}

model SalePayment {
  id                 String   @id @default(uuid())
  saleId             String
  sale               Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMode        String   // 'CASH' | 'UPI' | 'BANK' | 'CHEQUE' | 'BAJAJ_FINANCE' | 'CREDIT_CARD' | 'OTHER'
  amount             Decimal  @db.Decimal(12, 2)
  referenceNumber    String?
  emiProvider        String?  // e.g. "Bajaj Finance", "HDFC"
  emiReferenceNumber String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([saleId])
}

model Subscription {
  id              String   @id @default(uuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  planName        String
  billingInterval String   // 'MONTHLY' | 'YEARLY'
  amount          Decimal  @db.Decimal(12, 2)
  startDate       DateTime
  nextBillingDate DateTime
  status          String   @default("ACTIVE") // 'ACTIVE' | 'CANCELLED' | 'PAUSED'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
}

model SaleItem {
  id                String   @id @default(uuid())
  saleId            String
  sale              Sale     @relation(fields: [saleId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Decimal  @db.Decimal(12, 2)
  totalPrice        Decimal  @db.Decimal(12, 2)
  taxableUnitPrice  Decimal  @db.Decimal(12, 2)
  taxableTotalPrice Decimal  @db.Decimal(12, 2)
  gstRate           Decimal  @default(0) @db.Decimal(5, 2)
  cgstAmount        Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount        Decimal  @default(0) @db.Decimal(12, 2)
  igstAmount        Decimal  @default(0) @db.Decimal(12, 2)
  hsnCode           String?  // Snapshot of HSN at time of sale
  unit              String   @default("PC") // Snapshot of unit at time of sale
  wattage           Float    @default(0)
  comboGroupId      String?
  comboGroup        SaleComboGroup? @relation(fields: [comboGroupId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productUnits      ProductUnit[]

  @@index([saleId])
  @@index([productId])
}

model SaleReturn {
  id             String   @id @default(uuid())
  returnNumber   String   @unique
  originalSaleId String
  originalSale   Sale     @relation(fields: [originalSaleId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  refundAmount   Decimal  @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@index([originalSaleId])
  @@index([customerId])
  @@index([deletedAt])
}

model SaleService {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  name        String   
  amount        Decimal  @db.Decimal(12, 2)
  gstRate       Decimal  @default(0) @db.Decimal(5, 2)
  cgstAmount    Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount    Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal  @default(0) @db.Decimal(12, 2)
  isGstInclusive Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([saleId])
}

model QuotationService {
  id          String   @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name        String   
  amount        Decimal  @db.Decimal(12, 2)
  gstRate       Decimal  @default(0) @db.Decimal(5, 2)
  cgstAmount    Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount    Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal  @default(0) @db.Decimal(12, 2)
  isGstInclusive Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quotationId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, isActive])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  ipAddress String?
  userAgent String?
  status    String   // 'SUCCESS' | 'FAILED'
  reason    String?
  createdAt DateTime @default(now())
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id              String   @id @default(uuid())
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount          Decimal  @db.Decimal(12, 2)
  date            DateTime
  paymentMode     String?  // CASH, UPI, BANK
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([categoryId])
  @@index([date])
  @@index([deletedAt])
}

model Warehouse {
  id          String   @id @default(uuid())
  name        String   @unique
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productUnits  ProductUnit[]
  audits        InventoryAudit[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
}

model StockTransfer {
  id              String   @id @default(uuid())
  transferNumber  String   @unique
  fromWarehouseId String
  toWarehouseId   String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status          String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  transferDate    DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  items           StockTransferItem[]
}

model StockTransferItem {
  id              String   @id @default(uuid())
  transferId      String
  transfer        StockTransfer @relation(fields: [transferId], references: [id])
  productUnitId   String
  productUnit     ProductUnit @relation(fields: [productUnitId], references: [id])
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  poNumber    String   @unique
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  status      String   @default("DRAFT") // DRAFT, SENT, PARTIAL, COMPLETED, CANCELLED
  expectedDate DateTime?
  grandTotal  Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  poItems     PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id          String   @id @default(uuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
}

model InventoryAudit {
  id          String   @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  status      String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  conductedBy String?
  auditDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  items       InventoryAuditItem[]
}

model InventoryAuditItem {
  id              String   @id @default(uuid())
  auditId         String
  audit           InventoryAudit @relation(fields: [auditId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  expectedQty     Int
  actualQty       Int
  discrepancy     Int
  notes           String?
}

model SaleComboGroup {
  id             String     @id @default(uuid())
  saleId         String
  sale           Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  name           String
  totalPrice     Decimal    @db.Decimal(12, 2)
  isGstInclusive Boolean    @default(true)
  items          SaleItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model QuotationComboGroup {
  id             String          @id @default(uuid())
  quotationId    String
  quotation      Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name           String
  totalPrice     Decimal         @db.Decimal(12, 2)
  isGstInclusive Boolean         @default(true)
  items          QuotationItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model InvoiceSequence {
  id        String   @id // e.g. "INV/26-27/" or "QT/26-27/"
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model BusinessProfile {
  id                      String   @id @default(uuid())
  tenantId                String   @unique @default("default-tenant")

  // Basic Information
  businessName            String   @default("Anshika Enterprises")
  legalName               String?
  businessType            String   @default("BOTH") // RETAIL, WHOLESALE, BOTH, SERVICE
  businessCategory        String?  @default("Power & Solar Appliances") // batteries, inverters, solar, electrical, etc.
  logoUrl                 String?  @db.Text
  ownerName               String?

  // Contact Information
  phone                   String?
  alternatePhone          String?
  email                   String?
  website                 String?

  // Address Details
  addressLine1            String?
  addressLine2            String?
  city                    String?
  district                String?
  state                   String   @default("Uttar Pradesh")
  stateCode               String   @default("09")
  pincode                 String?
  country                 String   @default("India")

  // Tax & Compliance Details
  gstin                   String?
  pan                     String?
  gstType                 String   @default("REGULAR") // REGULAR, COMPOSITION, UNREGISTERED
  defaultGstRate          Decimal  @default(18) @db.Decimal(5, 2)
  defaultHsn              String?

  // Bank & UPI Details
  accountHolderName       String?
  bankName                String?
  encryptedAccountNumber  String?  @db.Text // AES-256-GCM encrypted
  accountNumberLast4      String?  // Stored for fast masked display (XXXX1234)
  ifscCode                String?
  bankBranch              String?
  upiId                   String?
  qrCodeUrl               String?  @db.Text

  // Invoice & Print Settings
  invoicePrefix           String   @default("INV")
  startingNumber          Int      @default(1)
  termsAndConditions      String?  @db.Text
  signatureUrl            String?  @db.Text
  defaultPrintSize        String   @default("A4") // A4, 80MM, 58MM
  showBankDetails         Boolean  @default(true)

  // Multi-Branch Integration
  branches                Json     @default("[]") // Array of { id, name, address, phone, gstin }

  // Audit & Verification
  needsReverification     Boolean  @default(false)
  updatedBy               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([tenantId])
}

